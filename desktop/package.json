{
  "name": "aervelys-next-desktop",
  "version": "0.5.1",
  "description": "AERVELYS NEXT offline-first virtual pilot career and charter market",
  "private": true,
  "author": "AERVELYS NEXT",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test:syntax": "node --check main.cjs",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.aervelys.next.desktop",
    "productName": "AERVELYS NEXT",
    "copyright": "Copyright © 2026 AERVELYS NEXT",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "security.cjs",
      "offline.html",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json",
      "nativeBridge.cjs",
      "local.html",
      "local.css",
      "local.js",
      "preload.cjs",
      "localStore.cjs",
      "pilotProfiles.cjs",
      "offlineMarket.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "AERVELYS-NEXT-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AERVELYS NEXT",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "../bridge/Aervelys.SimBridge",
        "to": "simbridge-src",
        "filter": [
          "**/*.cs"
        ]
      }
    ]
  }
}
